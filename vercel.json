{
  "framework": "vite",
  "installCommand": "NODE_ENV=development npm install --include=dev --foreground-scripts && chmod +x node_modules/.bin/*",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
